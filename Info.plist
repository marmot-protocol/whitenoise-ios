<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>White Noise saves photos and videos to your photo library only when you choose to save them from the share sheet.</string>
	<key>AppGroupIdentifier</key>
	<string>$(APP_GROUP_IDENTIFIER)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(WN_URL_SCHEME)</string>
				<string>$(WN_LEGACY_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>NSUserActivityTypes</key>
	<array>
		<string>INSendMessageIntent</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>WnLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>WNFlavor</key>
	<string>$(WN_FLAVOR)</string>
	<key>WNLegacyURLScheme</key>
	<string>$(WN_LEGACY_URL_SCHEME)</string>
	<key>WNURLScheme</key>
	<string>$(WN_URL_SCHEME)</string>
	<key>WhiteNoiseAuditLogBearerToken</key>
	<string>$(WHITENOISE_AUDIT_LOG_BEARER_TOKEN)</string>
	<key>WhiteNoiseGiphyAPIKey</key>
	<string>$(WHITENOISE_GIPHY_API_KEY)</string>
	<key>WhiteNoisePushRelayHint</key>
	<string>$(WHITENOISE_PUSH_RELAY_HINT)</string>
	<key>WhiteNoisePushServerPubkeyHex</key>
	<string>$(WHITENOISE_PUSH_SERVER_PUBKEY_HEX)</string>
	<key>WhiteNoiseTelemetryBearerToken</key>
	<string>$(WHITENOISE_OTLP_BEARER_TOKEN)</string>
	<key>WhiteNoiseTelemetryEnvironment</key>
	<string>$(WHITENOISE_TELEMETRY_ENVIRONMENT)</string>
	<key>WhiteNoiseTelemetryOTLPEndpoint</key>
	<string>$(WHITENOISE_OTLP_ENDPOINT)</string>
	<key>WhiteNoiseProductAnalyticsEndpoint</key>
	<string>$(WHITENOISE_PRODUCT_ANALYTICS_ENDPOINT)</string>
	<key>WhiteNoiseProductAnalyticsAppKey</key>
	<string>$(WHITENOISE_PRODUCT_ANALYTICS_APP_KEY)</string>
	<key>WhiteNoiseProductAnalyticsOperator</key>
	<string>$(WHITENOISE_PRODUCT_ANALYTICS_OPERATOR)</string>
	<key>WhiteNoiseProductAnalyticsRetention</key>
	<string>$(WHITENOISE_PRODUCT_ANALYTICS_RETENTION)</string>
</dict>
</plist>
