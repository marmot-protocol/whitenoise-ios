        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saia enquanto mantém este perfil no dispositivo ou remova permanentemente seus dados locais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выйдите из системы, сохранив этот профиль на устройстве, или навсегда удалите его локальные данные."
