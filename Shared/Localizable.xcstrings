    "This permanently removes every local audit JSONL file on this device." : {
      "comment" : "A message displayed in a confirmation dialog that deletes all audit logs.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies entfernt dauerhaft jede lokale Audit-JSONL-Datei auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permanently removes every local audit JSONL file on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina permanentemente cada archivo JSONL de auditoría local en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime définitivement chaque fichier JSONL d'audit local sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo rimuove permanentemente ogni file JSONL di audit locale su questo dispositivo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove permanentemente cada arquivo JSONL de auditoria local neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это навсегда удалит все локальные JSONL-файлы аудита на этом устройстве."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, bu cihazdaki tüm yerel denetim JSONL dosyalarını kalıcı olarak kaldırır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除此设备上的每个本地审计 JSONL 文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將永久移除此裝置上的每個本地稽核 JSONL 檔案。"
          }
        }
      }
    },
    "This permanently removes recorded diagnostic activity for all profiles from this device. Your logging preference won’t change." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden die aufgezeichneten Diagnoseaktivitäten aller Profile dauerhaft von diesem Gerät entfernt. Deine Protokollierungseinstellung bleibt unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permanently removes recorded diagnostic activity for all profiles from this device. Your logging preference won’t change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina permanentemente de este dispositivo la actividad de diagnóstico registrada de todos los perfiles. Tu preferencia de registro no cambiará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime définitivement de cet appareil l’activité de diagnostic enregistrée pour tous les profils. Votre préférence de journalisation ne sera pas modifiée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione rimuove definitivamente da questo dispositivo le attività diagnostiche registrate di tutti i profili. La preferenza di registrazione non cambia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove permanentemente deste dispositivo as atividades de diagnóstico registradas de todos os perfis. Sua preferência de registro não será alterada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это безвозвратно удалит с устройства записанную диагностическую активность всех профилей. Настройка записи журналов не изменится."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem, tüm profillerin kaydedilmiş tanılama etkinliklerini bu cihazdan kalıcı olarak kaldırır. Günlük kaydı tercihiniz değişmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将从此设备永久移除所有个人资料已记录的诊断活动。你的日志记录偏好不会改变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將從此裝置永久移除所有個人檔案已記錄的診斷活動。你的記錄偏好設定不會改變。"
          }
        }
      }
    },
    "This permanently removes the chat and its messages from this device. Signing in again won’t restore them." : {
      "comment" : "A message displayed when the user deletes a chat.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden der Chat und seine Nachrichten dauerhaft von diesem Gerät entfernt. Durch eine erneute Anmeldung werden sie nicht wiederhergestellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina permanentemente el chat y sus mensajes de este dispositivo. Iniciar sesión nuevamente no los restaurará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime définitivement le chat et ses messages de cet appareil. Une nouvelle connexion ne les restaurera pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione rimuoverà definitivamente la chat e i relativi messaggi da questo dispositivo. L'accesso successivo non li ripristinerà."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove permanentemente o bate-papo e suas mensagens deste dispositivo. Fazer login novamente não irá restaurá-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При этом чат и его сообщения будут удалены с этого устройства навсегда. Повторный вход не восстановит их."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, sohbeti ve mesajlarını bu cihazdan kalıcı olarak kaldırır. Tekrar oturum açmak bunları geri yüklemez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将从该设备中永久删除聊天及其消息。再次登录不会恢复它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將從該設備中永久刪除聊天及其訊息。再次登入不會恢復它們。"
          }
        }
      }
    },
    "This permanently removes these chats and their messages from this device. Signing in again won’t restore them." : {
      "comment" : "A message displayed in a confirmation dialog for deleting multiple chats.",
      "extractionState" : "manual",
