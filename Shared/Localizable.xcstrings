    "Writes local audit JSONL files for forensic review using obscured identifiers and no message content. Changes apply immediately." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt lokale JSONL-Prüfprotokolle für die forensische Prüfung mit verschleierten Kennungen und ohne Nachrichteninhalte. Änderungen werden sofort wirksam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe archivos de auditoría JSONL locales para la revisión forense, con identificadores ocultos y sin contenido de mensajes. Los cambios se aplican de inmediato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrit des fichiers d’audit JSONL locaux pour l’analyse forensique, avec des identifiants masqués et sans contenu de message. Les modifications s’appliquent immédiatement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrive file di audit JSONL locali per l’analisi forense, con identificatori oscurati e senza contenuto dei messaggi. Le modifiche vengono applicate immediatamente."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grava arquivos de auditoria JSONL locais para análise forense, com identificadores ocultados e sem conteúdo de mensagens. As alterações são aplicadas imediatamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывает локальные файлы аудита JSONL для криминалистического анализа со скрытыми идентификаторами и без содержимого сообщений. Изменения применяются немедленно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adli inceleme için gizlenmiş tanımlayıcılarla ve mesaj içeriği olmadan yerel JSONL denetim dosyaları yazar. Değişiklikler hemen uygulanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写入本地 JSONL 审计文件以供取证审查，其中标识符已隐藏且不包含消息内容。更改会立即生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫入本機 JSONL 稽核檔案以供鑑識審查，其中識別碼已隱藏且不包含訊息內容。變更會立即生效。"
          }
        }
      }
    },
