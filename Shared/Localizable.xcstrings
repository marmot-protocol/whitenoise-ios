    "Relays let your profile publish information, receive chat invitations, and deliver messages." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relays ermöglichen deinem Profil, Informationen zu veröffentlichen, Chat-Einladungen zu empfangen und Nachrichten zuzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
