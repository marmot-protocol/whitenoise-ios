    "The stored Marmot group record could not be read or refreshed. Retry may help after a transient storage failure." : {
      "comment" : "Text displayed in a notification when a group record load fails.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der gespeicherte Marmot-Gruppeneintrag konnte nicht gelesen oder aktualisiert werden. Nach einem vorübergehenden Speicherfehler kann ein erneuter Versuch helfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer ni actualizar el registro de grupo de Marmot almacenado. Reintentar puede ayudar después de un fallo temporal del almacenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement de groupe Marmot stocké n’a pas pu être lu ni actualisé. Réessayer peut aider après une défaillance temporaire du stockage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere o aggiornare il record del gruppo Marmot memorizzato. Riprovare può essere utile dopo un errore temporaneo di archiviazione."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler nem atualizar o registro de grupo do Marmot armazenado. Tentar novamente pode ajudar após uma falha temporária de armazenamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать или обновить сохранённую запись группы Marmot. Повторная попытка может помочь после временного сбоя хранилища."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saklanan Marmot grup kaydı okunamadı veya yenilenemedi. Geçici bir depolama hatasından sonra yeniden denemek yardımcı olabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取或刷新已存储的 Marmot 群组记录。若存储暂时出现故障，重试可能会有所帮助。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取或重新整理已儲存的 Marmot 群組記錄。若儲存空間暫時發生故障，重試可能會有幫助。"
          }
        }
      }
    },
    "The stored MLS session could not be opened. Retry may help if storage was temporarily unavailable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
