    "Only rejoin if you trust this invitation. A newer group version alone does not make it trustworthy." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tritt nur erneut bei, wenn du dieser Einladung vertraust. Eine neuere Gruppenversion allein macht sie nicht vertrauenswürdig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only rejoin if you trust this invitation. A newer group version alone does not make it trustworthy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a unirte solo si confías en esta invitación. Una versión más reciente del grupo no la hace fiable por sí sola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne rejoignez à nouveau le groupe que si vous faites confiance à cette invitation. Une version plus récente du groupe ne suffit pas à la rendre fiable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rientra solo se ti fidi di questo invito. Una versione più recente del gruppo non lo rende affidabile da sola."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volte a entrar apenas se confiar neste convite. Uma versão mais recente do grupo, por si só, não o torna fiável."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вступайте повторно, только если доверяете этому приглашению. Более новая версия группы сама по себе не делает его надёжным."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca bu davete güveniyorsanız yeniden katılın. Grubun daha yeni bir sürümü olması tek başına onu güvenilir kılmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在信任此邀请时才重新加入。仅仅是较新的群组版本并不意味着它可信。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在信任此邀請時才重新加入。僅僅是較新的群組版本並不代表它可信。"
          }
        }
      }
    },
    "Only you are here" : {
