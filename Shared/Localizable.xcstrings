    "Higher quality uses more data. Identifying photo metadata, like location, is always removed before sending." : {
      "comment" : "A description of the quality of the photos and videos that are sent.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhere Qualität verbraucht mehr Daten. Identifizierende Foto-Metadaten wie der Standort werden vor dem Senden immer entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una calidad más alta consume más datos. Los metadatos identificativos de las fotos, como la ubicación, siempre se eliminan antes de enviarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une qualité supérieure consomme plus de données. Les métadonnées identifiantes des photos, comme la localisation, sont toujours supprimées avant l’envoi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una qualità più alta consuma più dati. I metadati identificativi delle foto, come la posizione, vengono sempre rimossi prima dell’invio."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualidade mais alta consome mais dados. Metadados identificáveis das fotos, como a localização, são sempre removidos antes do envio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более высокое качество расходует больше данных. Идентифицирующие метаданные фото, например геопозиция, всегда удаляются перед отправкой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha yüksek kalite daha fazla veri kullanır. Konum gibi kimlik belirtici fotoğraf üst verileri gönderilmeden önce her zaman kaldırılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画质越高，流量消耗越大。位置等可识别身份的照片元数据在发送前始终会被移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "畫質越高，流量消耗越大。位置等可識別身分的照片中介資料在傳送前一律會被移除。"
          }
        }
      }
    },
