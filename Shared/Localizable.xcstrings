    "Loaded member credentials or ratchet-tree state failed validation. Retry does not bypass that validation." : {
      "comment" : "Text displayed in a quarantine alert when a group's member validation fails.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die geladenen Mitgliedsanmeldedaten oder der Ratchet-Tree-Zustand haben die Validierung nicht bestanden. Ein erneuter Versuch umgeht diese Validierung nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las credenciales de miembro cargadas o el estado del ratchet-tree no superaron la validación. Reintentar no omite esa validación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les identifiants de membre chargés ou l’état du ratchet-tree n’ont pas passé la validation. Réessayer ne contourne pas cette validation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le credenziali del membro caricate o lo stato del ratchet-tree non hanno superato la convalida. Riprovare non aggira questa convalida."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As credenciais de membro carregadas ou o estado do ratchet-tree não passaram na validação. Tentar novamente não ignora essa validação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверка загруженных учётных данных участника или состояния ratchet-tree не пройдена. Повторная попытка не обходит эту проверку."
          }
        },
        "tr" : {
