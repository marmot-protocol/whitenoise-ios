    "Messaging is disabled while the request is processed." : {
      "comment" : "Warning banner message displayed when the app is unable to send a message.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während die Anfrage verarbeitet wird, ist die Nachrichtenübermittlung deaktiviert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mensajería está deshabilitada mientras se procesa la solicitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La messagerie est désactivée pendant le traitement de la demande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La messaggistica è disabilitata durante l'elaborazione della richiesta."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As mensagens ficam desativadas enquanto a solicitação é processada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обмен сообщениями отключен на время обработки запроса."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstek işlenirken mesajlaşma devre dışı bırakılır."
