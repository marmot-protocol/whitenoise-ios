    "Archiving hides the chat from your main list. It doesn't notify anyone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Archivieren wird der Chat aus deiner Hauptliste ausgeblendet. Niemand wird benachrichtigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiving hides the chat from your main list. It doesn't notify anyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivar oculta el chat de tu lista principal. No se notifica a nadie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'archivage masque la discussion de votre liste principale. Personne n'est notifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'archiviazione nasconde la chat dall'elenco principale. Nessuno riceve notifiche."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivar oculta a conversa da sua lista principal. Ninguém é notificado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архивация скрывает чат из основного списка. Никто не получит уведомление."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arşivleme, sohbeti ana listenden gizler. Kimseye bildirim gitmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "归档会将聊天从主列表中隐藏，不会通知任何人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封存會將聊天從主清單中隱藏，不會通知任何人。"
