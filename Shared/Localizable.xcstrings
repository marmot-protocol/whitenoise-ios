    "Configure or clear logs in Privacy & Security → Diagnostics & Improvements. Export saves a sanitized activity summary without event payloads." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protokolle unter Datenschutz & Sicherheit → Diagnose & Verbesserungen konfigurieren oder löschen. Der Export speichert eine bereinigte Aktivitätsübersicht ohne Ereignisinhalte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure or clear logs in Privacy & Security → Diagnostics & Improvements. Export saves a sanitized activity summary without event payloads."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura o borra los registros en Privacidad y seguridad → Diagnóstico y mejoras. La exportación guarda un resumen de actividad depurado sin el contenido de los eventos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurez ou effacez les journaux dans Confidentialité et sécurité → Diagnostic et améliorations. L’export enregistre un résumé d’activité expurgé, sans le contenu des événements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura o cancella i log in Privacy e sicurezza → Diagnostica e miglioramenti. L’esportazione salva un riepilogo delle attività depurato, senza il contenuto degli eventi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure ou limpe os registros em Privacidade e segurança → Diagnóstico e melhorias. A exportação salva um resumo de atividades higienizado, sem o conteúdo dos eventos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настроить или очистить журналы можно в разделе «Конфиденциальность и безопасность → Диагностика и улучшения». При экспорте сохраняется очищенная сводка активности без содержимого событий."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günlükleri Gizlilik ve Güvenlik → Tanılama ve İyileştirmeler bölümünde yapılandırın veya temizleyin. Dışa aktarma, olay içerikleri olmadan arındırılmış bir etkinlik özeti kaydeder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
