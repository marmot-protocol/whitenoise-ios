    "Let's chat on White Noise — private, secure messaging. Get it at https://whitenoise.chat and share your profile QR with me." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass uns auf White Noise chatten — private, sichere Nachrichten. Hol es dir auf https://whitenoise.chat und teile deinen Profil-QR mit mir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let's chat on White Noise — private, secure messaging. Get it at https://whitenoise.chat and share your profile QR with me."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hablemos en White Noise: mensajería privada y segura. Descárgala en https://whitenoise.chat y comparte conmigo tu QR de perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discutons sur White Noise — messagerie privée et sécurisée. Téléchargez-la sur https://whitenoise.chat et partagez votre QR de profil avec moi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parliamo su White Noise — messaggistica privata e sicura. Scaricala da https://whitenoise.chat e condividi con me il tuo QR del profilo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vamos conversar no White Noise — mensagens privadas e seguras. Baixe em https://whitenoise.chat e compartilhe comigo o QR do seu perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Давай общаться в White Noise — приватном и безопасном мессенджере. Скачай на https://whitenoise.chat и поделись со мной QR-кодом профиля."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
