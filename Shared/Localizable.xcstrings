    "Locks White Noise when you leave. Your iPhone passcode can be used if biometric authentication isn't available." : {
      "comment" : "Footer for the app lock setting.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperrt White Noise, wenn du die App verlässt. Dein iPhone-Code kann verwendet werden, wenn die biometrische Authentifizierung nicht verfügbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquea White Noise cuando sales de la app. Se puede usar el código de tu iPhone si la autenticación biométrica no está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouille White Noise lorsque vous quittez l’app. Le code de votre iPhone peut être utilisé si l’authentification biométrique n’est pas disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocca White Noise quando esci dall’app. Il codice del tuo iPhone può essere usato se l’autenticazione biometrica non è disponibile."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueia o White Noise quando você sai do app. O código do seu iPhone pode ser usado se a autenticação biométrica não estiver disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блокирует White Noise, когда вы выходите из приложения. Если биометрическая аутентификация недоступна, можно использовать код-пароль iPhone."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamadan çıktığınızda White Noise’u kilitler. Biyometrik kimlik doğrulama kullanılamıyorsa iPhone şifreniz kullanılabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离开应用时锁定 White Noise。如果无法使用生物识别验证，可改用 iPhone 密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離開應用程式時鎖定 White Noise。若無法使用生物辨識驗證，可改用 iPhone 密碼。"
          }
        }
      }
    },
