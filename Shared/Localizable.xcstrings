            "state" : "translated",
            "value" : "Continuaremos tentando em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы продолжим попытки в фоновом режиме."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka planda denemeye devam edeceğiz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们会在后台继续尝试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們會在背景繼續嘗試。"
          }
        }
      }
    },
    "Web search sends your query and IP address to DuckDuckGo and image hosts." : {
      "comment" : "Privacy disclosure shown below the group image web search field.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Websuche sendet deine Suchanfrage und IP-Adresse an DuckDuckGo und Bildanbieter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda web envía tu consulta y dirección IP a DuckDuckGo y a los servidores de imágenes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche web envoie votre requête et votre adresse IP à DuckDuckGo et aux hôtes d’images."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ricerca web invia la tua query e il tuo indirizzo IP a DuckDuckGo e agli host delle immagini."
          }
        },
        "pt" : {
