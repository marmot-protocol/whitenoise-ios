    "Muting silences this chat's notification banners and sounds on this device. Messages still arrive and count as unread." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Stummschalten werden Banner und Töne dieses Chats auf diesem Gerät unterdrückt. Nachrichten kommen weiterhin an und zählen als ungelesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muting silences this chat's notification banners and sounds on this device. Messages still arrive and count as unread."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silenciar desactiva los avisos y sonidos de este chat en este dispositivo. Los mensajes siguen llegando y cuentan como no leídos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sourdine désactive les bannières et les sons de cette discussion sur cet appareil. Les messages arrivent toujours et comptent comme non lus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il silenzioso disattiva banner e suoni di questa chat su questo dispositivo. I messaggi continuano ad arrivare e contano come non letti."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silenciar desativa os avisos e sons desta conversa neste dispositivo. As mensagens continuam chegando e contam como não lidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без звука: баннеры и звуки этого чата отключаются на этом устройстве. Сообщения продолжают приходить и считаются непрочитанными."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessize almak bu sohbetin bildirim afişlerini ve seslerini bu cihazda kapatır. Mesajlar gelmeye devam eder ve okunmamış sayılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静音会在此设备上关闭此聊天的通知横幅和提示音。消息仍会送达并计为未读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "靜音會在此裝置上關閉此聊天的通知橫幅和提示音。訊息仍會送達並計為未讀。"
          }
        }
      }
    },
