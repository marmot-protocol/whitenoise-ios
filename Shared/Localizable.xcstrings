          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los relays permiten a tu perfil publicar información, recibir invitaciones a chats y entregar mensajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
