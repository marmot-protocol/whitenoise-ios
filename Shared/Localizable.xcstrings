    "White Noise does not yet sync conversations across devices. We recommend using this account on one device." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise synchronisiert Unterhaltungen noch nicht zwischen Geräten. Wir empfehlen, dieses Konto auf einem Gerät zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise does not yet sync conversations across devices. We recommend using this account on one device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise aún no sincroniza conversaciones entre dispositivos. Recomendamos usar esta cuenta en un solo dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise ne synchronise pas encore les conversations entre appareils. Nous recommandons d’utiliser ce compte sur un seul appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise non sincronizza ancora le conversazioni tra dispositivi. Consigliamo di usare questo account su un solo dispositivo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O White Noise ainda não sincroniza conversas entre dispositivos. Recomendamos usar esta conta em um único dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise пока не синхронизирует переписки между устройствами. Рекомендуем использовать этот аккаунт на одном устройстве."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise henüz sohbetleri cihazlar arasında eşitlemiyor. Bu hesabı tek cihazda kullanmanı öneriyoruz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise 尚不能跨设备同步对话。我们建议在一台设备上使用此账户。"
