    "White Noise is free and open source. Donations help us improve it and keep it available to everyone." : {
      "comment" : "A description of the benefits of donating to White Noise.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise ist kostenlos und Open Source. Spenden helfen uns, es zu verbessern und für alle verfügbar zu halten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise es gratuito y de código abierto. Las donaciones nos ayudan a mejorarlo y a mantenerlo disponible para todos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise est gratuit et open source. Les dons nous aident à l’améliorer et à le garder accessible à tous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise è gratuito e open source. Le donazioni ci aiutano a migliorarlo e a mantenerlo disponibile per tutti."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O White Noise é gratuito e de código aberto. As doações nos ajudam a melhorá-lo e a mantê-lo disponível para todos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise бесплатен и имеет открытый исходный код. Пожертвования помогают нам улучшать его и сохранять доступным для всех."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise ücretsiz ve açık kaynaklıdır. Bağışlar onu geliştirmemize ve herkes için erişilebilir tutmamıza yardımcı olur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
