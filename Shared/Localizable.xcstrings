    "Rejoining replaces this device’s current group state with the invited copy. Your saved message history is kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der erneute Beitritt ersetzt den aktuellen Gruppenzustand dieses Geräts durch die eingeladene Kopie. Dein gespeicherter Nachrichtenverlauf bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejoining replaces this device’s current group state with the invited copy. Your saved message history is kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volver a unirte sustituye el estado actual del grupo en este dispositivo por la copia de la invitación. Se conserva tu historial de mensajes guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejoindre à nouveau remplace l’état actuel du groupe sur cet appareil par la copie proposée dans l’invitation. Votre historique de messages enregistré est conservé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rientrare sostituisce lo stato attuale del gruppo su questo dispositivo con la copia proposta nell’invito. La cronologia dei messaggi salvata viene mantenuta."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voltar a entrar substitui o estado atual do grupo neste dispositivo pela cópia do convite. O histórico de mensagens guardado é mantido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторное вступление заменит текущее состояние группы на этом устройстве копией из приглашения. Сохранённая история сообщений останется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden katılmak, bu cihazdaki mevcut grup durumunu davetteki kopyayla değiştirir. Kayıtlı mesaj geçmişiniz korunur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新加入会将此设备上的当前群组状态替换为邀请中的副本。已保存的消息历史将保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新加入會將此裝置上的目前群組狀態替換為邀請中的副本。已儲存的訊息歷史將保留。"
          }
        }
      }
    },
