      }
    },
    "Everyone will be removed and the group will be permanently disbanded. No one will be able to send new messages. This can't be undone." : {
      "comment" : "Confirmation message for disbanding a group.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder wird entfernt und die Gruppe wird dauerhaft aufgelöst. Niemand kann neue Nachrichten senden. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos serán eliminados y el grupo se disolverá permanentemente. Nadie podrá enviar mensajes nuevos. Esto no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le monde sera supprimé et le groupe sera définitivement dissous. Personne ne pourra envoyer de nouveaux messages. Cela ne peut pas être annulé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti verranno rimossi e il gruppo verrà sciolto definitivamente. Nessuno sarà in grado di inviare nuovi messaggi. L'operazione non può essere annullata."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
