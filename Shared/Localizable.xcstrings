    "Sign out while keeping this profile on the device, or permanently remove its local data." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melden Sie sich ab, während Sie dieses Profil auf dem Gerät behalten, oder entfernen Sie die lokalen Daten dauerhaft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra sesión manteniendo este perfil en el dispositivo o elimina permanentemente sus datos locales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déconnectez-vous tout en conservant ce profil sur l'appareil ou supprimez définitivement ses données locales."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
