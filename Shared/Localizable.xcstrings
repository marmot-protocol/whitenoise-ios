    },
    "Hide Screen in App Switcher" : {
      "comment" : "A toggle that hides the app's content in the app switcher.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirm im App-Umschalter verbergen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar la pantalla en el selector de apps"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer l’écran dans le sélecteur d’apps"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascondi la schermata nel selettore app"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar a tela no alternador de apps"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывать экран в переключателе приложений"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekranı uygulama değiştiricide gizle"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在应用切换器中隐藏画面"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在應用程式切換器中隱藏畫面"
          }
        }
      }
    },
    "Hides the app's content in the app switcher and requires unlocking when you return." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet den Inhalt der App im App-Umschalter aus und verlangt beim Zurückkehren eine Entsperrung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta el contenido de la app en el selector de apps y requiere desbloquear al volver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masque le contenu de l'app dans le sélecteur d'apps et demande un déverrouillage au retour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasconde il contenuto dell'app nel selettore delle app e richiede lo sblocco al ritorno."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta o conteúdo do app no seletor de apps e exige desbloqueio ao voltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывает содержимое приложения в переключателе приложений и требует разблокировки при возвращении."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama içeriğini uygulama değiştiricide gizler ve geri döndüğünüzde kilidin açılmasını ister."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在应用切换器中隐藏应用内容，返回时需要解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在應用程式切換器中隱藏應用程式內容，返回時需要解鎖。"
          }
        }
      }
    },
    "Hides your conversations and profile details in the app switcher. Screenshots and screen recordings also show a blank screen." : {
      "comment" : "A description of the app switcher setting.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbirgt deine Unterhaltungen und Profildetails im App-Umschalter. Screenshots und Bildschirmaufnahmen zeigen ebenfalls einen leeren Bildschirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta tus conversaciones y los datos de tu perfil en el selector de apps. Las capturas y grabaciones de pantalla también muestran una pantalla en blanco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masque vos conversations et les détails de votre profil dans le sélecteur d’apps. Les captures et enregistrements d’écran affichent aussi un écran vide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasconde le tue conversazioni e i dettagli del profilo nel selettore app. Anche screenshot e registrazioni dello schermo mostrano una schermata vuota."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta suas conversas e os detalhes do perfil no alternador de apps. Capturas e gravações de tela também mostram uma tela em branco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывает ваши переписки и данные профиля в переключателе приложений. Снимки и записи экрана также показывают пустой экран."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sohbetlerinizi ve profil ayrıntılarınızı uygulama değiştiricide gizler. Ekran görüntüleri ve ekran kayıtları da boş bir ekran gösterir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在应用切换器中隐藏你的对话和个人资料详情。截屏和录屏也会显示空白画面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在應用程式切換器中隱藏你的對話和個人檔案詳情。螢幕截圖和螢幕錄影也會顯示空白畫面。"
          }
        }
      }
