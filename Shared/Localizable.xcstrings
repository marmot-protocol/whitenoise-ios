    "Usage analytics are scheduled for automatic deletion after 180 days." : {
      "extractionState" : "manual",
      "comment" : "Verified deployment retention statement; translate the wording without changing the 180-day period.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die automatische Löschung der Nutzungsanalysedaten ist nach 180 Tagen vorgesehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage analytics are scheduled for automatic deletion after 180 days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de análisis de uso se programan para su eliminación automática después de 180 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression automatique des données d’analyse d’utilisation est prévue après 180 jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’eliminazione automatica dei dati di analisi dell’utilizzo è programmata dopo 180 giorni."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A exclusão automática dos dados de análise de uso está programada para ocorrer após 180 dias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматическое удаление данных аналитики использования запланировано через 180 дней."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
