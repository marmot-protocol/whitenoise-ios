// Settings common to both flavors. Flavor-specific values live in
// Production.xcconfig / Staging.xcconfig, which #include this file.
// Local telemetry secrets come from AppBuildSettings.xcconfig.
#include "AppBuildSettings.xcconfig"

// Telemetry + native-push config shared by both flavors. Previously inlined
// per build config in project.pbxproj.
// `//` starts an xcconfig comment, so the scheme separator is assembled from a
// single-slash helper that expands after comment parsing; otherwise these URLs
// truncate to `https:` / `wss:`.
WN_SLASH = /
WHITENOISE_OTLP_ENDPOINT = https:$(WN_SLASH)$(WN_SLASH)otlp.ipf.dev/v1/metrics
WHITENOISE_PUSH_RELAY_HINT = wss:$(WN_SLASH)$(WN_SLASH)relay.eu.whitenoise.chat
// Shared vs flavor-specific token/endpoint rules: Config/AGENTS.md.
WHITENOISE_AUDIT_LOG_BEARER_TOKEN = $(AUDIT_LOG_TOKEN_WHITENOISE_IOS)
WHITENOISE_GIPHY_API_KEY = $(GIPHY_API_KEY_WHITENOISE_IOS)

INFOPLIST_KEY_NSLocationWhenInUseUsageDescription = White Noise uses your location only when you choose to share it in an encrypted chat.

// Provision the full verified ingestion route and retention disclosure before distribution.
WHITENOISE_PRODUCT_ANALYTICS_ENDPOINT = $(APTABASE_EVENTS_ENDPOINT_WHITENOISE_IOS)
WHITENOISE_PRODUCT_ANALYTICS_OPERATOR = white_noise
WHITENOISE_PRODUCT_ANALYTICS_RETENTION = $(APTABASE_RETENTION_WHITENOISE_IOS)
