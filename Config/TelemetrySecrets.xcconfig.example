// Copy to Config/TelemetrySecrets.xcconfig (gitignored) and fill in local secrets.
// Production and staging OTLP tokens identify separate tenants.
// The audit-log token is shared by both flavors.
PRODUCTION_OTLP_TOKEN_WHITENOISE_IOS =
STAGING_OTLP_TOKEN_WHITENOISE_IOS =
AUDIT_LOG_TOKEN_WHITENOISE_IOS =
GIPHY_API_KEY_WHITENOISE_IOS =

// Separate Aptabase applications; never reuse the OTLP/audit tokens.
PRODUCTION_APTABASE_KEY_WHITENOISE_IOS =
STAGING_APTABASE_KEY_WHITENOISE_IOS =
// Full events URL, with xcconfig-safe slash expansion; verify against deployment.
APTABASE_EVENTS_ENDPOINT_WHITENOISE_IOS =
// Human-readable, verified retention policy. Required before distribution.
APTABASE_RETENTION_WHITENOISE_IOS =
