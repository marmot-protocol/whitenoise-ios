    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise verwendet die Kamera, um Profil-QR-Codes zu scannen und Fotos und Videos für verschlüsselte Chats aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise uses the camera to scan profile QR codes and take photos and videos for encrypted chats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise usa la cámara para escanear códigos QR de perfiles y tomar fotos y videos para chats cifrados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise utilise la caméra pour scanner les codes QR des profils et prendre des photos et des vidéos pour les discussions chiffrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise usa la fotocamera per scansionare i codici QR dei profili e scattare foto e registrare video per le chat crittografate."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O White Noise usa a câmera para ler códigos QR de perfis e tirar fotos e gravar vídeos para conversas criptografadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise использует камеру для сканирования QR-кодов профилей, съёмки фото и видео для зашифрованных чатов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise, profil QR kodlarını taramak ve şifreli sohbetler için fotoğraf ve video çekmek amacıyla kamerayı kullanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise 使用相机扫描个人资料二维码，并为加密聊天拍摄照片和视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise 使用相機掃描個人資料 QR 碼，並為加密聊天拍攝照片和影片。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise verwendet Face ID, um die App zu entsperren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise uses Face ID to unlock the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise usa Face ID para desbloquear la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise utilise Face ID pour déverrouiller l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise usa Face ID per sbloccare l’app."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O White Noise usa o Face ID para desbloquear o app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise использует Face ID для разблокировки приложения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise, uygulamanın kilidini açmak için Face ID kullanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise 使用 Face ID 解锁应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise 使用 Face ID 解鎖應用程式。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise verwendet deinen Standort nur, wenn du ihn in einem verschlüsselten Chat teilen möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise uses your location only when you choose to share it in an encrypted chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise usa tu ubicación solo cuando decides compartirla en un chat cifrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise utilise votre position uniquement lorsque vous choisissez de la partager dans une discussion chiffrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise usa la tua posizione solo quando scegli di condividerla in una chat crittografata."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O White Noise usa sua localização somente quando você escolhe compartilhá-la em uma conversa criptografada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise использует ваше местоположение, только когда вы решаете поделиться им в зашифрованном чате."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise, konumunuzu yalnızca şifreli bir sohbette paylaşmayı seçtiğinizde kullanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise 仅在你选择在加密聊天中分享位置时使用你的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise 只會在你選擇於加密聊天中分享位置時使用你的位置。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise verwendet das Mikrofon, um verschlüsselte Sprachnachrichten und Videos für Chats aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise uses the microphone to record encrypted voice messages and chat videos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise usa el micrófono para grabar mensajes de voz cifrados y videos para chats."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise utilise le microphone pour enregistrer des messages vocaux chiffrés et des vidéos pour les discussions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise usa il microfono per registrare messaggi vocali crittografati e video per le chat."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O White Noise usa o microfone para gravar mensagens de voz criptografadas e vídeos para conversas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise использует микрофон для записи зашифрованных голосовых сообщений и видео для чатов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise, şifreli sesli mesajlar ve sohbet videoları kaydetmek için mikrofonu kullanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise 使用麦克风录制加密语音消息和聊天视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise 使用麥克風錄製加密語音訊息和聊天影片。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise speichert Fotos und Videos nur in deiner Fotomediathek, wenn du sie über das Teilen-Menü speicherst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise saves photos and videos to your photo library only when you choose to save them from the share sheet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise guarda fotos y videos en tu fototeca solo cuando eliges guardarlos desde el menú para compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise enregistre des photos et des vidéos dans votre photothèque uniquement lorsque vous choisissez de les enregistrer depuis le menu de partage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise salva foto e video nella tua libreria solo quando scegli di salvarli dal menu di condivisione."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O White Noise salva fotos e vídeos na sua fototeca somente quando você escolhe salvá-los pelo menu de compartilhamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise сохраняет фото и видео в вашу медиатеку, только когда вы выбираете сохранение в меню «Поделиться»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise, fotoğraf ve videoları yalnızca paylaşım menüsünden kaydetmeyi seçtiğinizde fotoğraf arşivinize kaydeder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise 仅在你选择从分享菜单保存照片和视频时，将它们存入你的照片图库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise 只會在你選擇從分享選單儲存照片和影片時，將它們存入你的照片圖庫。"
          }
        }
      }
    }
  },
  "version" : "1.0"
